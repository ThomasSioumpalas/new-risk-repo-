# Version control
.git
.gitignore
.github

# Python / uv
.venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
dist
build

# Coverage / test artifacts
.coverage
.coverage.*
coverage.xml
htmlcov

# Local databases
*.db
*.sqlite3

# Tests and docs are not needed inside the runtime image
tests
docs

# Editor / OS cruft
.DS_Store
.vscode
.idea
*.swp

# Local env files (examples/reports are kept: they ship in the image)
.env
.env.*
!.env.example

# Compose / CI-only files not needed in the build context copy
docker-compose.yml
.pre-commit-config.yaml
