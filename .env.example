# Example environment configuration for Sextant.
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is listed in .gitignore and must never be committed.
#
# All settings are read from the environment with the SEXTANT_ prefix
# (see src/sextant/config.py). docker-compose.yml also reads the
# POSTGRES_* variables below to configure the `db` service.

# --- Application ------------------------------------------------------------

# development | test | production
SEXTANT_ENV=development

# sqlite:///./sextant.db for a zero-setup local run, or
# postgresql+psycopg://user:pass@host:5432/db (requires the `postgres` extra)
SEXTANT_DATABASE_URL=sqlite:///./sextant.db

SEXTANT_LOG_LEVEL=INFO
SEXTANT_LOG_JSON=true

# Upper bound on Monte Carlo trials accepted through the API (resource-exhaustion guard)
SEXTANT_API_MAX_TRIALS=50000

# Bootstrap admin key, used once by `sextant users bootstrap`. Leave unset
# unless you are bootstrapping the first admin account; never commit a real
# value.
SEXTANT_BOOTSTRAP_ADMIN_KEY=

# --- docker-compose: PostgreSQL service -------------------------------------

POSTGRES_DB=sextant
POSTGRES_USER=sextant
# Required: docker-compose refuses to start the db/api services without it.
POSTGRES_PASSWORD=change-me
